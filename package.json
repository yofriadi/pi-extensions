{
	"name": "pi-extensions",
	"private": true,
	"type": "module",
	"version": "0.1.0",
	"scripts": {
		"test": "pnpm -r --if-present test",
		"update:pi-accounts": "bash scripts/update-pi-accounts-subtree.sh",
		"update:pi-condense": "bash scripts/update-pi-condense-subtree.sh",
		"update:session-recap": "bash scripts/update-session-recap-subtree.sh",
		"check": "biome check . && tsc --noEmit -p packages/pi-accounts/tsconfig.json && tsc --noEmit -p packages/pi-provider-antigravity/tsconfig.json && tsc --noEmit -p packages/pi-session-recap/tsconfig.json && tsc --noEmit -p packages/pi-toon/tsconfig.json",
		"check:fix": "biome check --write .",
		"prepare": "prek install",
		"fallow": "fallow",
		"fallow:audit": "fallow audit",
		"fallow:health": "fallow health --score --hotspots --targets",
		"fallow:dead-code": "fallow dead-code",
		"fallow:dupes": "fallow dupes"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@j178/prek": "0.4.11",
		"@types/node": "22.19.19",
		"fallow": "^3.8.0",
		"rumdl": "^0.2.40",
		"typescript": "5.9.3",
		"vitest": "3.2.4"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"packageManager": "pnpm@10.5.2"
}
