{
  "name": "@yofriadi/pi-permission-system",
  "version": "32.1.0",
  "description": "Permission enforcement extension for the Pi coding agent. (local fork: a custom system prompt's tool surface is left alone)",
  "type": "module",
  "forkOf": {
    "name": "@gotgenes/pi-permission-system",
    "version": "32.1.0",
    "repository": "git+https://github.com/gotgenes/pi-packages.git",
    "directory": "packages/pi-permission-system"
  },
  "exports": {
    ".": {
      "default": "./src/service.ts"
    }
  },
  "imports": {
    "#src/*": "./src/*",
    "#test/*": "./test/*"
  },
  "files": [
    "src",
    "dist",
    "config/config.example.json",
    "schemas/permissions.schema.json",
    "docs/*.md",
    "docs/guides",
    "docs/migration",
    "docs/assets",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "build:types": "rollup -c rollup.dts.config.mjs",
    "prepack": "pnpm run build:types",
    "gen:schema": "node --experimental-strip-types scripts/generate-permissions-schema.ts && biome format --write schemas/permissions.schema.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:public-types": "bash scripts/verify-public-types.sh",
    "measure:core-coverage": "node scripts/measure-core-coverage.mjs",
    "measure:path-false-positives": "node scripts/measure-path-false-positives.mjs",
    "measure:statement-descent": "node scripts/measure-statement-descent.mjs",
    "measure:statement-operands": "node scripts/measure-statement-operands.mjs",
    "measure:unresolved-redirects": "node scripts/measure-unresolved-redirects.mjs",
    "measure:wrapper-transparency": "node scripts/measure-wrapper-transparency.mjs",
    "lint:md": "rumdl check *.md docs/**/*.md",
    "lint": "biome check ."
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "pi-coding-agent",
    "coding-agent",
    "permissions",
    "policy",
    "access-control",
    "authorization",
    "security"
  ],
  "author": {
    "name": "Chris Lasher"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gotgenes/pi-packages.git",
    "directory": "packages/pi-permission-system"
  },
  "homepage": "https://github.com/gotgenes/pi-packages/tree/main/packages/pi-permission-system#readme",
  "bugs": {
    "url": "https://github.com/gotgenes/pi-packages/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.79.0",
    "@earendil-works/pi-tui": ">=0.79.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.5",
    "@earendil-works/pi-coding-agent": "0.79.1",
    "@earendil-works/pi-tui": "0.79.1",
    "@types/node": "22.19.19",
    "rollup": "^4.63.1",
    "rollup-plugin-dts": "^6.5.1",
    "rumdl": "^0.2.40",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "dependencies": {
    "tree-sitter-bash": "^0.25.1",
    "web-tree-sitter": "^0.26.9",
    "zod": "^4.4.3"
  }
}
