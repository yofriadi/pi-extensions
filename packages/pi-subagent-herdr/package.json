{
	"name": "@yofriadi/pi-subagent-herdr",
	"version": "0.5.0",
	"description": "Pi subagents in Herdr panes — async steer or blocking tool result, attached stack layout",
	"keywords": [
		"pi-package"
	],
	"license": "MIT",
	"author": "ycm (fork of 0xRichardH/pi-herdr-subagents)",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/yofriadi/pi-extensions.git",
		"directory": "packages/pi-subagent-herdr"
	},
	"files": [
		"src/",
		"README.md",
		"CHANGELOG.md",
		"LICENSE",
		"package.json"
	],
	"type": "module",
	"scripts": {
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"test": "vitest run",
		"test:coverage": "c8 --reporter=json --report-dir=coverage vitest run && node scripts/normalize-istanbul-coverage.mjs",
		"test:integration": "node --test --test-concurrency=1 test/integration/*.test.ts",
		"typecheck": "tsc --noEmit",
		"fallow": "fallow",
		"fallow:audit": "fallow audit",
		"fallow:health": "fallow health --score --hotspots --targets",
		"fallow:dead-code": "fallow dead-code",
		"fallow:dupes": "fallow dupes"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": ">=0.81.0",
		"@earendil-works/pi-coding-agent": ">=0.81.0",
		"@earendil-works/pi-tui": ">=0.81.0",
		"@sinclair/typebox": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "^0.84.1",
		"@earendil-works/pi-coding-agent": "^0.84.1",
		"@earendil-works/pi-tui": "^0.84.1",
		"@sinclair/typebox": "^0.34.52",
		"c8": "10.1.3",
		"fallow": "3.14.0",
		"vitest": "4.1.9"
	},
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"publishConfig": {
		"access": "public"
	}
}
